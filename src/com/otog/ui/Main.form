<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.otog.ui.Main">
  <grid id="mainRoot" binding="pnlRoot" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="10">
    <margin top="12" left="14" bottom="12" right="14"/>
    <constraints>
      <xy x="20" y="20" width="1020" height="680"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="mainHeader" binding="pnlHeader" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="6">
        <margin top="0" left="0" bottom="8" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="identityGrid" binding="pnlIdentity" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="2">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="lblWelcomeId" class="javax.swing.JLabel" binding="lblWelcome">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="SansSerif" size="16" style="1"/>
                  <text value="Welcome"/>
                </properties>
              </component>
              <component id="lblWalletIdComp" class="javax.swing.JLabel" binding="lblWalletId">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="SansSerif" size="12" style="0"/>
                  <text value="Wallet: --"/>
                </properties>
              </component>
              <component id="lblPinStatusId" class="javax.swing.JLabel" binding="lblPinStatus">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="SansSerif" size="11" style="0"/>
                  <text value="Transaction PIN: Checking..."/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="balanceBoxGrid" binding="pnlBalanceBox" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="1">
            <margin top="0" left="8" bottom="0" right="0"/>
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="2" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="lblBalCaption" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="SansSerif" size="11" style="0"/>
                  <horizontalAlignment value="4"/>
                  <text value="Available Balance"/>
                </properties>
              </component>
              <component id="lblBalanceId" class="javax.swing.JLabel" binding="lblBalance">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="SansSerif" size="18" style="1"/>
                  <horizontalAlignment value="4"/>
                  <text value="PHP 0.00"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="balanceActionsGrid" binding="pnlBalanceAndActions" layout-manager="FlowLayout" hgap="8" vgap="4" flow-align="2">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="btnBackId" class="javax.swing.JButton" binding="btnBack">
                <constraints/>
                <properties>
                  <enabled value="false"/>
                  <font name="SansSerif" size="12" style="0"/>
                  <text value="← Back"/>
                </properties>
              </component>
              <component id="btnRefreshId" class="javax.swing.JButton" binding="btnRefresh">
                <constraints/>
                <properties>
                  <font name="SansSerif" size="12" style="0"/>
                  <text value="Refresh"/>
                </properties>
              </component>
              <component id="btnNotificationsId" class="javax.swing.JButton" binding="btnNotifications">
                <constraints/>
                <properties>
                  <font name="SansSerif" size="12" style="0"/>
                  <text value="Notifications (0)"/>
                </properties>
              </component>
              <component id="btnPinSettingsHdrId" class="javax.swing.JButton" binding="btnPinSettings">
                <constraints/>
                <properties>
                  <font name="SansSerif" size="12" style="0"/>
                  <text value="Transaction PIN"/>
                </properties>
              </component>
              <component id="btnLogoutId" class="javax.swing.JButton" binding="btnLogout">
                <constraints/>
                <properties>
                  <font name="SansSerif" size="12" style="0"/>
                  <text value="Logout"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
      <tabbedpane id="mainTabsId" binding="tabs">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <minimum-size width="200" height="200"/>
          </grid>
        </constraints>
        <properties>
          <font name="SansSerif" size="12" style="1"/>
        </properties>
        <border type="none"/>
        <children/>
      </tabbedpane>
      <grid id="mainFooter" binding="pnlFooter" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="0">
        <margin top="6" left="2" bottom="2" right="2"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="lblStatusId" class="javax.swing.JLabel" binding="lblStatus">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="SansSerif" size="11" style="0"/>
              <text value="Initializing dashboard..."/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
