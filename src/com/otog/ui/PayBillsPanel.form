<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.otog.ui.PayBillsPanel">
  <grid id="payBillsRoot" binding="pnlRoot" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
    <margin top="16" left="16" bottom="16" right="16"/>
    <constraints>
      <xy x="20" y="20" width="700" height="420"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="payBillsForm" binding="pnlForm" layout-manager="GridLayoutManager" row-count="8" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
        <margin top="12" left="14" bottom="12" right="14"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Pay Utility &amp; Service Bills"/>
        <children>
          <component id="lblBiller" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Select Biller:"/>
            </properties>
          </component>
          <component id="cmbBillerId" class="javax.swing.JComboBox" binding="cmbBiller">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="lblBillReference" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Account / Reference Number:"/>
            </properties>
          </component>
          <component id="txtBillReferenceId" class="javax.swing.JTextField" binding="txtBillReference">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="lblBillAmount" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Amount (PHP):"/>
            </properties>
          </component>
          <component id="txtBillAmountId" class="javax.swing.JTextField" binding="txtBillAmount">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="lblFeeHeader" class="javax.swing.JLabel">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Fee Preview:"/>
            </properties>
          </component>
          <component id="lblFeePreviewId" class="javax.swing.JLabel" binding="lblFeePreview">
            <constraints>
              <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="SansSerif" size="12" style="1"/>
              <text value="PHP 0.00"/>
            </properties>
          </component>
          <component id="lblTotalHeader" class="javax.swing.JLabel">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Total to Pay:"/>
            </properties>
          </component>
          <component id="lblTotalPreviewId" class="javax.swing.JLabel" binding="lblTotalPreview">
            <constraints>
              <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="SansSerif" size="12" style="1"/>
              <text value="PHP 0.00"/>
            </properties>
          </component>
          <component id="lblBillPin" class="javax.swing.JLabel">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Transaction PIN:"/>
            </properties>
          </component>
          <component id="txtBillPinId" class="javax.swing.JPasswordField" binding="txtBillPin">
            <constraints>
              <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <grid id="billBtns" binding="pnlActions" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="0">
            <margin top="4" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="6" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="btnBillSubmitId" class="javax.swing.JButton" binding="btnSubmitBillPayment">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="SansSerif" size="12" style="1"/>
                  <text value="Pay Bill"/>
                </properties>
              </component>
              <component id="btnBillBackId" class="javax.swing.JButton" binding="btnBillBackToOverview">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="SansSerif" size="12" style="0"/>
                  <text value="← Back to Overview"/>
                </properties>
              </component>
              <hspacer id="billBtnSpacer">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
              </hspacer>
            </children>
          </grid>
          <component id="lblBillFeedbackId" class="javax.swing.JLabel" binding="lblBillFeedback">
            <constraints>
              <grid row="7" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="SansSerif" size="12" style="0"/>
              <text value=" "/>
            </properties>
          </component>
        </children>
      </grid>
      <vspacer id="billBottomSpacer">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
    </children>
  </grid>
</form>
