<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.otog.ui.LoanPanel">
  <grid id="loanRoot" binding="pnlRoot" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="8">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="840" height="580"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <tabbedpane id="tabsLoanId" binding="tabsLoan">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <minimum-size width="200" height="200"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="borrowerTab" binding="pnlBorrowerTab" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="8">
            <margin top="10" left="10" bottom="10" right="10"/>
            <constraints>
              <tabbedpane title="My Loans &amp; Application"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <grid id="loanProductSummary" binding="pnlProductSummary" layout-manager="GridLayoutManager" row-count="4" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="6">
                <margin top="8" left="10" bottom="8" right="10"/>
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="etched" title="Configured Simulated Loan Product"/>
                <children>
                  <component id="lblLoanProdCaption" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Product:"/>
                    </properties>
                  </component>
                  <component id="lblProductNameId" class="javax.swing.JLabel" binding="lblProductName">
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <font name="SansSerif" size="13" style="1"/>
                      <text value="OTOG Simulated Quick Cash Loan (OTOG-SIM-LOAN)"/>
                    </properties>
                  </component>
                  <component id="lblTermsCaption" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Terms &amp; Rate:"/>
                    </properties>
                  </component>
                  <component id="lblProductTermsId" class="javax.swing.JLabel" binding="lblProductTerms">
                    <constraints>
                      <grid row="1" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Principal PHP 500.00 - PHP 10,000.00 | 3.00%/mo | 3 months [SIMULATED]"/>
                    </properties>
                  </component>
                  <component id="lblFormulaCaption" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Calculation:"/>
                    </properties>
                  </component>
                  <component id="lblFormulaSummaryId" class="javax.swing.JLabel" binding="lblFormulaSummary">
                    <constraints>
                      <grid row="2" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Total Repayment = Principal + (Principal x Rate x Term) + Processing Fee"/>
                    </properties>
                  </component>
                  <component id="lblDueCaption" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Amount Due:"/>
                    </properties>
                  </component>
                  <component id="lblOutstandingDueId" class="javax.swing.JLabel" binding="lblOutstandingDue">
                    <constraints>
                      <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <font name="SansSerif" size="13" style="1"/>
                      <text value="PHP 0.00"/>
                    </properties>
                  </component>
                  <component id="lblScopeCaption" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="3" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Repayment:"/>
                    </properties>
                  </component>
                  <component id="lblScopeNoticeId" class="javax.swing.JLabel" binding="lblScopeNotice">
                    <constraints>
                      <grid row="3" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Full lump-sum only (installments/partial/penalties deferred)"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <grid id="loanApplyForm" binding="pnlApplicationForm" layout-manager="GridLayoutManager" row-count="4" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="6">
                <margin top="8" left="10" bottom="8" right="10"/>
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="etched" title="Simulated Loan Application &amp; Repayment Preview"/>
                <children>
                  <component id="lblPrincipalCaption" class="javax.swing.JLabel" binding="lblPrincipalCaption">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Principal Amount (PHP):"/>
                    </properties>
                  </component>
                  <component id="txtPrincipalId" class="javax.swing.JTextField" binding="txtPrincipal">
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                  </component>
                  <component id="lblLoanPreviewCaption" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Repayment Preview:"/>
                    </properties>
                  </component>
                  <component id="lblPreviewSummaryId" class="javax.swing.JLabel" binding="lblPreviewSummary">
                    <constraints>
                      <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Enter principal amount and click Preview Repayment."/>
                    </properties>
                  </component>
                  <grid id="loanApplyActions" binding="pnlApplyActions" layout-manager="FlowLayout" hgap="8" vgap="4" flow-align="0">
                    <constraints>
                      <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="btnPreviewLoanId" class="javax.swing.JButton" binding="btnPreviewLoan">
                        <constraints/>
                        <properties>
                          <text value="Preview Repayment"/>
                        </properties>
                      </component>
                      <component id="btnApplyLoanId" class="javax.swing.JButton" binding="btnApplyLoan">
                        <constraints/>
                        <properties>
                          <text value="Submit Application"/>
                        </properties>
                      </component>
                      <component id="btnLoanBackId" class="javax.swing.JButton" binding="btnBackToOverview">
                        <constraints/>
                        <properties>
                          <text value="← Back to Overview"/>
                        </properties>
                      </component>
                    </children>
                  </grid>
                  <component id="lblLoanFeedbackId" class="javax.swing.JLabel" binding="lblLoanFeedback">
                    <constraints>
                      <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value=" "/>
                    </properties>
                  </component>
                </children>
              </grid>
              <grid id="userLoansSection" binding="pnlUserLoans" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="6" vgap="6">
                <margin top="6" left="8" bottom="6" right="8"/>
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <minimum-size width="200" height="160"/>
                  </grid>
                </constraints>
                <properties/>
                <border type="etched" title="My Loan Applications &amp; Full Repayment"/>
                <children>
                  <scrollpane id="scrollUserLoansId" binding="scrollUserLoans">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                        <minimum-size width="180" height="110"/>
                        <preferred-size width="360" height="145"/>
                      </grid>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="tblUserLoansId" class="javax.swing.JTable" binding="tblUserLoans">
                        <constraints/>
                        <properties/>
                      </component>
                    </children>
                  </scrollpane>
                  <grid id="repayControlsBar" binding="pnlRepayControls" layout-manager="FlowLayout" hgap="8" vgap="4" flow-align="0">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="lblSelectedDueId" class="javax.swing.JLabel" binding="lblSelectedLoanDue">
                        <constraints/>
                        <properties>
                          <text value="Selected Due: --"/>
                        </properties>
                      </component>
                      <component id="lblRepayPinId" class="javax.swing.JLabel">
                        <constraints/>
                        <properties>
                          <text value="Transaction PIN:"/>
                        </properties>
                      </component>
                      <component id="txtRepayPinId" class="javax.swing.JPasswordField" binding="txtRepayPin">
                        <constraints/>
                        <properties>
                          <columns value="10"/>
                        </properties>
                      </component>
                      <component id="btnRepayLoanId" class="javax.swing.JButton" binding="btnRepayLoan">
                        <constraints/>
                        <properties>
                          <enabled value="false"/>
                          <text value="Repay Full Amount"/>
                        </properties>
                      </component>
                    </children>
                  </grid>
                  <component id="lblRepayFeedbackId" class="javax.swing.JLabel" binding="lblRepayFeedback">
                    <constraints>
                      <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value=" "/>
                    </properties>
                  </component>
                </children>
              </grid>
            </children>
          </grid>
          <grid id="adminLoanTab" binding="pnlAdminTab" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="8">
            <margin top="10" left="10" bottom="10" right="10"/>
            <constraints>
              <tabbedpane title="Admin Loan Approvals"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <scrollpane id="scrollAdminLoansId" binding="scrollAdminLoans">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <minimum-size width="180" height="140"/>
                    <preferred-size width="360" height="220"/>
                  </grid>
                </constraints>
                <properties/>
                <border type="etched" title="All Loan Applications (Admin Review &amp; Single Disbursement)"/>
                <children>
                  <component id="tblAdminLoansId" class="javax.swing.JTable" binding="tblAdminLoans">
                    <constraints/>
                    <properties/>
                  </component>
                </children>
              </scrollpane>
              <grid id="adminDecisionPanel" binding="pnlAdminDecision" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="6">
                <margin top="8" left="10" bottom="8" right="10"/>
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="etched" title="Admin Decision"/>
                <children>
                  <component id="lblAdminReasonCaption" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Decision Reason:"/>
                    </properties>
                  </component>
                  <component id="txtAdminReasonId" class="javax.swing.JTextField" binding="txtAdminReason">
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                  </component>
                  <grid id="adminActionsBar" binding="pnlAdminActions" layout-manager="FlowLayout" hgap="8" vgap="4" flow-align="0">
                    <constraints>
                      <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="btnAdminApproveId" class="javax.swing.JButton" binding="btnAdminApprove">
                        <constraints/>
                        <properties>
                          <enabled value="false"/>
                          <text value="Approve &amp; Disburse"/>
                        </properties>
                      </component>
                      <component id="btnAdminRejectId" class="javax.swing.JButton" binding="btnAdminReject">
                        <constraints/>
                        <properties>
                          <enabled value="false"/>
                          <text value="Reject Application"/>
                        </properties>
                      </component>
                      <component id="btnAdminRefreshId" class="javax.swing.JButton" binding="btnAdminRefresh">
                        <constraints/>
                        <properties>
                          <text value="Refresh Queue"/>
                        </properties>
                      </component>
                    </children>
                  </grid>
                </children>
              </grid>
              <component id="lblAdminFeedbackId" class="javax.swing.JLabel" binding="lblAdminFeedback">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value=" "/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </tabbedpane>
    </children>
  </grid>
</form>
