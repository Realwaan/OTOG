<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.otog.ui.InvestmentPanel">
  <grid id="invRoot" binding="pnlRoot" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
    <margin top="14" left="14" bottom="14" right="14"/>
    <constraints>
      <xy x="20" y="20" width="760" height="520"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="invSummary" binding="pnlProductSummary" layout-manager="GridLayoutManager" row-count="2" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="6">
        <margin top="10" left="12" bottom="10" right="12"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Seeded Simulated Investment Product"/>
        <children>
          <component id="lblProdCaption" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Product:"/>
            </properties>
          </component>
          <component id="lblProductNameId" class="javax.swing.JLabel" binding="lblProductName">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="SansSerif" size="13" style="1"/>
              <text value="OTOG Simulated Balanced Fund (OTOG-SIM-FUND)"/>
            </properties>
          </component>
          <component id="lblPriceCaption" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Simulated Price:"/>
            </properties>
          </component>
          <component id="lblSimulatedPriceId" class="javax.swing.JLabel" binding="lblSimulatedPrice">
            <constraints>
              <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="SansSerif" size="12" style="1"/>
              <text value="Simulated Fixed Price"/>
            </properties>
          </component>
          <component id="lblUnitsCaption" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Persisted Holdings:"/>
            </properties>
          </component>
          <component id="lblHoldingsUnitsId" class="javax.swing.JLabel" binding="lblHoldingsUnits">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="SansSerif" size="13" style="1"/>
              <text value="0.0000 units"/>
            </properties>
          </component>
          <component id="lblValueCaption" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Simulated Market Value:"/>
            </properties>
          </component>
          <component id="lblHoldingsValueId" class="javax.swing.JLabel" binding="lblHoldingsValue">
            <constraints>
              <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="SansSerif" size="13" style="1"/>
              <text value="0.00"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="invForm" binding="pnlOrderForm" layout-manager="GridLayoutManager" row-count="7" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="8">
        <margin top="10" left="12" bottom="10" right="12"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Simulated Purchase &amp; Redemption"/>
        <children>
          <component id="lblOpCaption" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Operation:"/>
            </properties>
          </component>
          <component id="cmbInvestOperationId" class="javax.swing.JComboBox" binding="cmbInvestOperation">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="lblUnitsInputCaption" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Units (e.g. 2.5000):"/>
            </properties>
          </component>
          <component id="txtInvestUnitsId" class="javax.swing.JTextField" binding="txtInvestUnits">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="lblAmountInputCaption" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Amount:"/>
            </properties>
          </component>
          <component id="txtInvestAmountId" class="javax.swing.JTextField" binding="txtInvestAmount">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="lblPinInputCaption" class="javax.swing.JLabel">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Transaction PIN (if set):"/>
            </properties>
          </component>
          <component id="txtInvestPinId" class="javax.swing.JPasswordField" binding="txtInvestPin">
            <constraints>
              <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="lblPreviewCaption" class="javax.swing.JLabel">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Order Preview:"/>
            </properties>
          </component>
          <component id="lblPreviewSummaryId" class="javax.swing.JLabel" binding="lblPreviewSummary">
            <constraints>
              <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Enter units or amount and click Preview Units &amp; Cost."/>
            </properties>
          </component>
          <grid id="invBtns" binding="pnlActions" layout-manager="GridLayoutManager" row-count="1" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="0">
            <margin top="4" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="btnPreviewInvestId" class="javax.swing.JButton" binding="btnPreviewInvest">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Preview Units &amp; Cost"/>
                </properties>
              </component>
              <component id="btnSubmitInvestId" class="javax.swing.JButton" binding="btnSubmitInvest">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Confirm Investment"/>
                </properties>
              </component>
              <component id="btnInvestBackId" class="javax.swing.JButton" binding="btnInvestBackToOverview">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="← Back to Overview"/>
                </properties>
              </component>
              <hspacer id="invBtnSpacer">
                <constraints>
                  <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
              </hspacer>
            </children>
          </grid>
          <component id="lblInvestFeedbackId" class="javax.swing.JLabel" binding="lblInvestFeedback">
            <constraints>
              <grid row="6" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value=" "/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="invActivity" binding="pnlActivity" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="6" vgap="6">
        <margin top="6" left="8" bottom="6" right="8"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Persisted Investment Activity"/>
        <children>
          <scrollpane id="scrollInvActId" binding="scrollInvestmentActivity">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="tblInvActId" class="javax.swing.JTable" binding="tblInvestmentActivity">
                <constraints/>
                <properties/>
              </component>
            </children>
          </scrollpane>
        </children>
      </grid>
    </children>
  </grid>
</form>
