<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.otog.ui.OverviewPanel">
  <grid id="overviewRoot" binding="pnlRoot" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
    <margin top="10" left="8" bottom="6" right="8"/>
    <constraints>
      <xy x="20" y="20" width="880" height="500"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="quickActionsGrid" binding="pnlQuickActions" layout-manager="FlowLayout" hgap="8" vgap="6" flow-align="0">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Quick Actions &amp; Statement Files"/>
        <children>
          <component id="btnCashInId" class="javax.swing.JButton" binding="btnNavCashIn">
            <constraints/>
            <properties>
              <font name="SansSerif" size="12" style="0"/>
              <text value="Cash In"/>
            </properties>
          </component>
          <component id="btnCashOutId" class="javax.swing.JButton" binding="btnNavCashOut">
            <constraints/>
            <properties>
              <font name="SansSerif" size="12" style="0"/>
              <text value="Cash Out"/>
            </properties>
          </component>
          <component id="btnSendMoneyId" class="javax.swing.JButton" binding="btnNavSendMoney">
            <constraints/>
            <properties>
              <font name="SansSerif" size="12" style="0"/>
              <text value="Send Money"/>
            </properties>
          </component>
          <component id="btnNavPayBillsId" class="javax.swing.JButton" binding="btnNavPayBills">
            <constraints/>
            <properties>
              <font name="SansSerif" size="12" style="0"/>
              <text value="Pay Bills"/>
            </properties>
          </component>
          <component id="btnInvestId" class="javax.swing.JButton" binding="btnNavInvest">
            <constraints/>
            <properties>
              <font name="SansSerif" size="12" style="0"/>
              <text value="Investments"/>
            </properties>
          </component>
          <component id="btnLoansId" class="javax.swing.JButton" binding="btnNavLoans">
            <constraints/>
            <properties>
              <font name="SansSerif" size="12" style="0"/>
              <text value="Loans"/>
            </properties>
          </component>
          <component id="btnMerchantQrId" class="javax.swing.JButton" binding="btnNavMerchantQr">
            <constraints/>
            <properties>
              <font name="SansSerif" size="12" style="0"/>
              <text value="Merchant QR"/>
            </properties>
          </component>
          <component id="btnPinSettingsId" class="javax.swing.JButton" binding="btnNavPinSettings">
            <constraints/>
            <properties>
              <font name="SansSerif" size="12" style="0"/>
              <text value="Set / Change PIN"/>
            </properties>
          </component>
          <component id="btnExportStmtId" class="javax.swing.JButton" binding="btnExportStatement">
            <constraints/>
            <properties>
              <font name="SansSerif" size="12" style="0"/>
              <text value="Export Statement"/>
            </properties>
          </component>
          <component id="btnLoadStmtId" class="javax.swing.JButton" binding="btnLoadStatement">
            <constraints/>
            <properties>
              <font name="SansSerif" size="12" style="0"/>
              <text value="Load Statement"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="recentActivityGrid" binding="pnlRecentActivity" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="8">
        <margin top="6" left="8" bottom="6" right="8"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Recent Activity &amp; History"/>
        <children>
          <grid id="historyFiltersGrid" binding="pnlHistoryFilters" layout-manager="FlowLayout" hgap="6" vgap="4" flow-align="0">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <grid id="filterTypeGroup" layout-manager="FlowLayout" hgap="4" vgap="0" flow-align="0">
                <constraints/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="lblFilterTypeId" class="javax.swing.JLabel">
                    <constraints/>
                    <properties>
                      <font name="SansSerif" size="12" style="0"/>
                      <text value="Type:"/>
                    </properties>
                  </component>
                  <component id="cmbFilterTypeId" class="javax.swing.JComboBox" binding="cmbFilterType">
                    <constraints/>
                    <properties/>
                  </component>
                </children>
              </grid>
              <grid id="filterStatusGroup" layout-manager="FlowLayout" hgap="4" vgap="0" flow-align="0">
                <constraints/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="lblFilterStatusId" class="javax.swing.JLabel">
                    <constraints/>
                    <properties>
                      <font name="SansSerif" size="12" style="0"/>
                      <text value="Status:"/>
                    </properties>
                  </component>
                  <component id="cmbFilterStatusId" class="javax.swing.JComboBox" binding="cmbFilterStatus">
                    <constraints/>
                    <properties/>
                  </component>
                </children>
              </grid>
              <grid id="filterFromGroup" layout-manager="FlowLayout" hgap="4" vgap="0" flow-align="0">
                <constraints/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="lblFilterFromId" class="javax.swing.JLabel">
                    <constraints/>
                    <properties>
                      <font name="SansSerif" size="12" style="0"/>
                      <text value="From:"/>
                    </properties>
                  </component>
                  <component id="txtFilterFromId" class="javax.swing.JTextField" binding="txtFilterFromDate">
                    <constraints/>
                    <properties>
                      <columns value="9"/>
                      <toolTipText value="Start date (YYYY-MM-DD)"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <grid id="filterToGroup" layout-manager="FlowLayout" hgap="4" vgap="0" flow-align="0">
                <constraints/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="lblFilterToId" class="javax.swing.JLabel">
                    <constraints/>
                    <properties>
                      <font name="SansSerif" size="12" style="0"/>
                      <text value="To:"/>
                    </properties>
                  </component>
                  <component id="txtFilterToId" class="javax.swing.JTextField" binding="txtFilterToDate">
                    <constraints/>
                    <properties>
                      <columns value="9"/>
                      <toolTipText value="End date (YYYY-MM-DD)"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <grid id="filterKeywordGroup" layout-manager="FlowLayout" hgap="4" vgap="0" flow-align="0">
                <constraints/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="lblFilterKeywordId" class="javax.swing.JLabel">
                    <constraints/>
                    <properties>
                      <font name="SansSerif" size="12" style="0"/>
                      <text value="Search:"/>
                    </properties>
                  </component>
                  <component id="txtFilterKeywordId" class="javax.swing.JTextField" binding="txtFilterKeyword">
                    <constraints/>
                    <properties>
                      <columns value="14"/>
                      <toolTipText value="Search by reference, provider ref, biller ref, channel, product, or description"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <grid id="filterButtonsGroup" layout-manager="FlowLayout" hgap="6" vgap="0" flow-align="0">
                <constraints/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="btnApplyFiltersId" class="javax.swing.JButton" binding="btnApplyFilters">
                    <constraints/>
                    <properties>
                      <font name="SansSerif" size="12" style="1"/>
                      <text value="Filter"/>
                    </properties>
                  </component>
                  <component id="btnClearFiltersId" class="javax.swing.JButton" binding="btnClearFilters">
                    <constraints/>
                    <properties>
                      <font name="SansSerif" size="12" style="0"/>
                      <text value="Reset"/>
                    </properties>
                  </component>
                </children>
              </grid>
            </children>
          </grid>
          <grid id="activityCardsId" binding="activityCardPanel" layout-manager="CardLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <minimum-size width="200" height="150"/>
                <preferred-size width="420" height="190"/>
              </grid>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <grid id="loadingCardGrid" binding="pnlLoadingCard" layout-manager="GridBagLayout">
                <constraints>
                  <card name="LOADING"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="lblLoadingId" class="javax.swing.JLabel" binding="lblLoadingState">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                      <gridbag weightx="0.0" weighty="0.0"/>
                    </constraints>
                    <properties>
                      <font name="SansSerif" size="13" style="2"/>
                      <text value="Loading wallet balance and recent activity..."/>
                    </properties>
                  </component>
                </children>
              </grid>
              <grid id="emptyCardGrid" binding="pnlEmptyCard" layout-manager="GridBagLayout">
                <constraints>
                  <card name="EMPTY"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="lblEmptyId" class="javax.swing.JLabel" binding="lblEmptyState">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                      <gridbag weightx="0.0" weighty="0.0"/>
                    </constraints>
                    <properties>
                      <font name="SansSerif" size="13" style="0"/>
                      <text value="No recent transactions yet. Use Cash In or Send Money to get started."/>
                    </properties>
                  </component>
                </children>
              </grid>
              <grid id="errorCardGrid" binding="pnlErrorCard" layout-manager="GridBagLayout">
                <constraints>
                  <card name="ERROR"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <grid id="errorInnerGrid" binding="pnlErrorInner" layout-manager="BorderLayout" hgap="8" vgap="10">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                      <gridbag weightx="0.0" weighty="0.0"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="lblErrorId" class="javax.swing.JLabel" binding="lblErrorState">
                        <constraints border-constraint="Center"/>
                        <properties>
                          <font name="SansSerif" size="13" style="0"/>
                          <horizontalAlignment value="0"/>
                          <text value="Unable to load wallet activity."/>
                        </properties>
                      </component>
                      <grid id="retryWrapperGrid" binding="pnlRetryWrapper" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
                        <constraints border-constraint="South"/>
                        <properties/>
                        <border type="none"/>
                        <children>
                          <component id="btnRetryId" class="javax.swing.JButton" binding="btnRetryLoad">
                            <constraints/>
                            <properties>
                              <font name="SansSerif" size="12" style="0"/>
                              <text value="Retry"/>
                            </properties>
                          </component>
                        </children>
                      </grid>
                    </children>
                  </grid>
                </children>
              </grid>
              <grid id="readyCardGrid" binding="pnlReadyCard" layout-manager="BorderLayout" hgap="6" vgap="6">
                <constraints>
                  <card name="READY"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <scrollpane id="txnsScrollPane">
                    <constraints border-constraint="Center"/>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="tblTxnsId" class="javax.swing.JTable" binding="tblTransactions">
                        <constraints/>
                        <properties/>
                      </component>
                    </children>
                  </scrollpane>
                  <grid id="tableActionsGrid" binding="pnlTableActions" layout-manager="BorderLayout" hgap="6" vgap="4">
                    <constraints border-constraint="South"/>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="lblFeedbackId" class="javax.swing.JLabel" binding="lblActivityFeedback">
                        <constraints border-constraint="North"/>
                        <properties>
                          <font name="SansSerif" size="12" style="0"/>
                          <text value=" "/>
                        </properties>
                      </component>
                      <grid id="tableActionButtonsGrid" binding="pnlTableActionButtons" layout-manager="FlowLayout" hgap="8" vgap="4" flow-align="2">
                        <constraints border-constraint="Center"/>
                        <properties/>
                        <border type="none"/>
                        <children>
                          <component id="btnStatusId" class="javax.swing.JButton" binding="btnCheckStatus">
                            <constraints/>
                            <properties>
                              <enabled value="false"/>
                              <font name="SansSerif" size="12" style="0"/>
                              <text value="Lookup Status"/>
                            </properties>
                          </component>
                          <component id="btnRepeatDraftId" class="javax.swing.JButton" binding="btnRepeatDraft">
                            <constraints/>
                            <properties>
                              <enabled value="false"/>
                              <font name="SansSerif" size="12" style="0"/>
                              <text value="Repeat Draft"/>
                            </properties>
                          </component>
                          <component id="btnReceiptId" class="javax.swing.JButton" binding="btnViewReceipt">
                            <constraints/>
                            <properties>
                              <font name="SansSerif" size="12" style="0"/>
                              <text value="View Receipt"/>
                            </properties>
                          </component>
                          <component id="btnExportReceiptId" class="javax.swing.JButton" binding="btnExportReceipt">
                            <constraints/>
                            <properties>
                              <font name="SansSerif" size="12" style="0"/>
                              <text value="Save Receipt File"/>
                            </properties>
                          </component>
                        </children>
                      </grid>
                    </children>
                  </grid>
                </children>
              </grid>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
