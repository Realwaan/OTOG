<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.otog.ui.PinSettingsDialog">
  <grid id="pinRoot" binding="pnlRoot" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="10">
    <margin top="14" left="18" bottom="12" right="18"/>
    <constraints>
      <xy x="20" y="20" width="440" height="300"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="pinForm" binding="pnlForm" layout-manager="GridLayoutManager" row-count="5" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="8">
        <margin top="10" left="12" bottom="10" right="12"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Transaction PIN Security"/>
        <children>
          <grid id="pinModePanel" binding="pnlMode" layout-manager="FlowLayout" hgap="10" vgap="2" flow-align="0">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="rbChangePinId" class="javax.swing.JRadioButton" binding="rbChangePin">
                <constraints/>
                <properties>
                  <text value="Use Current PIN"/>
                </properties>
              </component>
              <component id="rbResetPinId" class="javax.swing.JRadioButton" binding="rbResetWithPassword">
                <constraints/>
                <properties>
                  <text value="Reset with Account Password"/>
                </properties>
              </component>
            </children>
          </grid>
          <component id="lblSecretId" class="javax.swing.JLabel" binding="lblSecret">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Account Password:"/>
            </properties>
          </component>
          <component id="txtSecretId" class="javax.swing.JPasswordField" binding="txtSecret">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="180" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="lblNewPinId" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="New PIN (4-6 digits):"/>
            </properties>
          </component>
          <component id="txtNewPinId" class="javax.swing.JPasswordField" binding="txtNewPin">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="180" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="lblConfirmPinId" class="javax.swing.JLabel">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Confirm New PIN:"/>
            </properties>
          </component>
          <component id="txtConfirmPinId" class="javax.swing.JPasswordField" binding="txtConfirmPin">
            <constraints>
              <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="180" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="lblFeedbackId" class="javax.swing.JLabel" binding="lblPinDialogFeedback">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="SansSerif" size="11" style="0"/>
              <text value=" "/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="pinButtons" binding="pnlButtons" layout-manager="FlowLayout" hgap="8" vgap="4" flow-align="2">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="btnPinCancelId" class="javax.swing.JButton" binding="btnCancel">
            <constraints/>
            <properties>
              <text value="Cancel"/>
            </properties>
          </component>
          <component id="btnPinSaveId" class="javax.swing.JButton" binding="btnSavePin">
            <constraints/>
            <properties>
              <text value="Save PIN"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
