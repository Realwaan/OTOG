<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.otog.ui.AdminControlsPanel">
  <grid id="adminRoot" binding="pnlRoot" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="8">
    <margin top="10" left="12" bottom="10" right="12"/>
    <constraints>
      <xy x="20" y="20" width="860" height="500"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="lblAdminTitleId" class="javax.swing.JLabel" binding="lblTitle">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="SansSerif" size="14" style="1"/>
          <text value="Admin Controls — Account Management &amp; Audit Log"/>
        </properties>
      </component>
      <splitpane id="adminSplitId" binding="splitPane">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <orientation value="0"/>
          <resizeWeight value="0.55"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="adminUsersTopId" binding="pnlUsers" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="4" vgap="4">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <splitpane position="left"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <scrollpane id="userScrollId">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="etched" title="Registered Accounts &amp; Wallets"/>
                <children>
                  <component id="userTableId" class="javax.swing.JTable" binding="userTable">
                    <constraints/>
                    <properties/>
                  </component>
                </children>
              </scrollpane>
              <grid id="adminBtnBarId" binding="pnlButtons" layout-manager="GridLayoutManager" row-count="1" column-count="7" same-size-horizontally="false" same-size-vertically="false" hgap="6" vgap="4">
                <margin top="2" left="0" bottom="2" right="0"/>
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="btnSuspendId" class="javax.swing.JButton" binding="btnSuspend">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Suspend User"/>
                    </properties>
                  </component>
                  <component id="btnReactivateId" class="javax.swing.JButton" binding="btnReactivate">
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Reactivate User"/>
                    </properties>
                  </component>
                  <component id="btnChangeRoleId" class="javax.swing.JButton" binding="btnChangeRole">
                    <constraints>
                      <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Change Role"/>
                    </properties>
                  </component>
                  <component id="btnViewUserTxnsId" class="javax.swing.JButton" binding="btnViewUserTxns">
                    <constraints>
                      <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="View User Txns"/>
                    </properties>
                  </component>
                  <component id="btnViewAllTxnsId" class="javax.swing.JButton" binding="btnViewAllTxns">
                    <constraints>
                      <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="All System Txns"/>
                    </properties>
                  </component>
                  <component id="btnRefreshAllId" class="javax.swing.JButton" binding="btnRefreshAll">
                    <constraints>
                      <grid row="0" column="5" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Refresh"/>
                    </properties>
                  </component>
                  <hspacer id="adminBtnSpacer">
                    <constraints>
                      <grid row="0" column="6" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                  </hspacer>
                </children>
              </grid>
            </children>
          </grid>
          <scrollpane id="auditScrollId">
            <constraints>
              <splitpane position="right"/>
            </constraints>
            <properties/>
            <border type="etched" title="Admin Action Audit Log"/>
            <children>
              <component id="auditTableId" class="javax.swing.JTable" binding="auditTable">
                <constraints/>
                <properties/>
              </component>
            </children>
          </scrollpane>
        </children>
      </splitpane>
      <component id="statusLblId" class="javax.swing.JLabel" binding="statusLbl">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="SansSerif" size="11" style="0"/>
          <text value="Loading admin records..."/>
        </properties>
      </component>
    </children>
  </grid>
</form>
