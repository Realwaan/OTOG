<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.otog.ui.MerchantQrPanel">
  <grid id="merchantQrRoot" binding="pnlRoot" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="760" height="520"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <tabbedpane id="tabsQrId" binding="tabsQr">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <minimum-size width="200" height="200"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="payTabGrid" binding="pnlPayTab" layout-manager="GridLayoutManager" row-count="7" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="8">
            <margin top="12" left="12" bottom="12" right="12"/>
            <constraints>
              <tabbedpane title="Pay Merchant (QR Import)"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="lblImportPromptId" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Select QR Code Image:"/>
                </properties>
              </component>
              <grid id="pnlImportActionsId" binding="pnlImportActions" layout-manager="FlowLayout" hgap="8" vgap="2" flow-align="0">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="btnImportQrId" class="javax.swing.JButton" binding="btnImportQr">
                    <constraints/>
                    <properties>
                      <text value="Import QR Image (.png)..."/>
                    </properties>
                  </component>
                  <component id="lblImportedFileId" class="javax.swing.JLabel" binding="lblImportedFile">
                    <constraints/>
                    <properties>
                      <text value="No QR file loaded."/>
                    </properties>
                  </component>
                </children>
              </grid>
              <component id="lblQrThumbnailId" class="javax.swing.JLabel" binding="lblQrThumbnail">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                    <preferred-size width="120" height="120"/>
                  </grid>
                </constraints>
                <properties>
                  <horizontalAlignment value="0"/>
                  <text value="[ QR Image ]"/>
                </properties>
              </component>
              <scrollpane id="scrollConfirmationId">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <minimum-size width="140" height="90"/>
                    <preferred-size width="260" height="110"/>
                  </grid>
                </constraints>
                <properties/>
                <border type="etched" title="Merchant Recipient Confirmation"/>
                <children>
                  <component id="txtConfirmationId" class="javax.swing.JTextArea" binding="txtConfirmation">
                    <constraints/>
                    <properties>
                      <editable value="false"/>
                      <font name="Monospaced" size="12" style="0"/>
                      <lineWrap value="true"/>
                      <text value="Import a merchant QR code image to confirm recipient and view details."/>
                      <wrapStyleWord value="true"/>
                    </properties>
                  </component>
                </children>
              </scrollpane>
              <component id="lblPayAmountId" class="javax.swing.JLabel" binding="lblPayAmount">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Payment Amount (PHP):"/>
                </properties>
              </component>
              <component id="txtPayAmountId" class="javax.swing.JTextField" binding="txtPayAmount">
                <constraints>
                  <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
              </component>
              <component id="lblPayPinId" class="javax.swing.JLabel">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Transaction PIN:"/>
                </properties>
              </component>
              <component id="txtPayPinId" class="javax.swing.JPasswordField" binding="txtPayPin">
                <constraints>
                  <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
              </component>
              <grid id="pnlPayActionButtonsId" binding="pnlPayActionButtons" layout-manager="FlowLayout" hgap="8" vgap="4" flow-align="0">
                <constraints>
                  <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="btnConfirmPayId" class="javax.swing.JButton" binding="btnConfirmPay">
                    <constraints/>
                    <properties>
                      <enabled value="false"/>
                      <text value="Confirm &amp; Pay"/>
                    </properties>
                  </component>
                  <component id="btnClearPayId" class="javax.swing.JButton" binding="btnClearPay">
                    <constraints/>
                    <properties>
                      <text value="Clear"/>
                    </properties>
                  </component>
                  <component id="btnBackToOverviewId" class="javax.swing.JButton" binding="btnBackToOverview">
                    <constraints/>
                    <properties>
                      <text value="← Back to Overview"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <component id="lblPayFeedbackId" class="javax.swing.JLabel" binding="lblPayFeedback">
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value=" "/>
                </properties>
              </component>
              <scrollpane id="scrollReceiptId">
                <constraints>
                  <grid row="6" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <minimum-size width="180" height="90"/>
                    <preferred-size width="320" height="120"/>
                  </grid>
                </constraints>
                <properties/>
                <border type="etched" title="Payment Receipt"/>
                <children>
                  <component id="txtReceiptId" class="javax.swing.JTextArea" binding="txtReceipt">
                    <constraints/>
                    <properties>
                      <editable value="false"/>
                      <font name="Monospaced" size="12" style="0"/>
                      <lineWrap value="true"/>
                      <wrapStyleWord value="true"/>
                    </properties>
                  </component>
                </children>
              </scrollpane>
            </children>
          </grid>
          <grid id="merchantTabGrid" binding="pnlMerchantTab" layout-manager="GridLayoutManager" row-count="6" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="8">
            <margin top="12" left="12" bottom="12" right="12"/>
            <constraints>
              <tabbedpane title="Merchant Terminal &amp; Sales"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="lblGenAmountId" class="javax.swing.JLabel" binding="lblGenAmount">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Amount (PHP, Optional):"/>
                </properties>
              </component>
              <component id="txtGenAmountId" class="javax.swing.JTextField" binding="txtGenAmount">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
              </component>
              <component id="lblGenNoteId" class="javax.swing.JLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Order / Note (Optional):"/>
                </properties>
              </component>
              <component id="txtGenNoteId" class="javax.swing.JTextField" binding="txtGenNote">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
              </component>
              <grid id="pnlGenButtonsId" binding="pnlGenButtons" layout-manager="FlowLayout" hgap="8" vgap="4" flow-align="0">
                <constraints>
                  <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="btnGenerateQrId" class="javax.swing.JButton" binding="btnGenerateQr">
                    <constraints/>
                    <properties>
                      <text value="Generate Merchant QR"/>
                    </properties>
                  </component>
                  <component id="btnSaveQrId" class="javax.swing.JButton" binding="btnSaveQr">
                    <constraints/>
                    <properties>
                      <enabled value="false"/>
                      <text value="Export / Save QR Image..."/>
                    </properties>
                  </component>
                </children>
              </grid>
              <component id="lblGeneratedQrId" class="javax.swing.JLabel" binding="lblGeneratedQr">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                    <preferred-size width="160" height="160"/>
                  </grid>
                </constraints>
                <properties>
                  <horizontalAlignment value="0"/>
                  <text value="[ Generated QR Preview ]"/>
                </properties>
              </component>
              <scrollpane id="scrollMerchantSalesId">
                <constraints>
                  <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <minimum-size width="180" height="120"/>
                    <preferred-size width="320" height="160"/>
                  </grid>
                </constraints>
                <properties/>
                <border type="etched" title="Received Merchant Payments"/>
                <children>
                  <component id="tblMerchantSalesId" class="javax.swing.JTable" binding="tblMerchantSales">
                    <constraints/>
                    <properties/>
                  </component>
                </children>
              </scrollpane>
              <grid id="pnlMerchantSalesActionsId" binding="pnlMerchantSalesActions" layout-manager="FlowLayout" hgap="8" vgap="4" flow-align="0">
                <constraints>
                  <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="btnViewMerchantReceiptId" class="javax.swing.JButton" binding="btnViewMerchantReceipt">
                    <constraints/>
                    <properties>
                      <enabled value="false"/>
                      <text value="View Merchant Receipt"/>
                    </properties>
                  </component>
                  <component id="btnRefreshSalesId" class="javax.swing.JButton" binding="btnRefreshSales">
                    <constraints/>
                    <properties>
                      <text value="Refresh Sales"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <component id="lblMerchantFeedbackId" class="javax.swing.JLabel" binding="lblMerchantFeedback">
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value=" "/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </tabbedpane>
    </children>
  </grid>
</form>
