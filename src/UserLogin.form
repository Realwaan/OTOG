<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="UserLogin">
  <grid id="27dc6" binding="pnlMain" layout-manager="GridLayoutManager" row-count="4" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
    <margin top="20" left="24" bottom="20" right="24"/>
    <constraints>
      <xy x="20" y="20" width="700" height="400"/>
    </constraints>
    <properties>
      <visible value="true"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="4f690" binding="pnlPassword" layout-manager="GridLayoutManager" row-count="5" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
        <margin top="12" left="16" bottom="12" right="16"/>
        <constraints>
          <grid row="0" column="0" row-span="3" col-span="3" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="OTOG E-Wallet — Sign In"/>
        <children>
          <component id="loginBannerLabel" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="SansSerif" size="16" style="1"/>
              <text value="One Team One Goal — Digital E-Wallet"/>
            </properties>
          </component>
          <component id="usernameLabel" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Username / Mobile / Email:"/>
            </properties>
          </component>
          <component id="usernameTextField" class="javax.swing.JTextField" binding="textFieldUsername">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="260" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="passwordLabel" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Password:"/>
            </properties>
          </component>
          <component id="passwordTextField" class="javax.swing.JPasswordField" binding="passwordFieldPasswordInput">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="260" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <echoChar value="*"/>
            </properties>
          </component>
          <component id="loginButton" class="javax.swing.JButton" binding="btnLogin">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Login"/>
            </properties>
          </component>
          <component id="registerButton" class="javax.swing.JButton" binding="btnRegister">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Create New Account / Register"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="43ad8" binding="pnl2FA" layout-manager="GridLayoutManager" row-count="5" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
        <margin top="12" left="16" bottom="12" right="16"/>
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="3" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <visible value="false"/>
        </properties>
        <border type="etched" title="Two-Factor Verification"/>
        <children>
          <component id="bd7cb" class="javax.swing.JLabel" binding="twoFactorHeaderLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <horizontalAlignment value="0"/>
              <text value="Login Successful! Complete Two-Factor Authentication (Simulated SMS):"/>
            </properties>
          </component>
          <component id="2faCodeLabel" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="2FA Code:"/>
            </properties>
          </component>
          <component id="2faTextField" class="javax.swing.JTextField" binding="textField2FA">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="verifyButton" class="javax.swing.JButton" binding="btnVerify2FA">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Verify"/>
            </properties>
          </component>
          <component id="resendOtpButton" class="javax.swing.JButton" binding="btnResendOtp">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Resend Simulated OTP"/>
            </properties>
          </component>
          <component id="backToLoginButton" class="javax.swing.JButton" binding="btnBackToLogin">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Back to Login"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
